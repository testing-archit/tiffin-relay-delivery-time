          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(prediction_input_bucket{feature=\"distance_km\"}[30m])))",
          "legendFormat": "live median km",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(10.5)",
